SELECT ?c ?cLabel ?coord ?pop ?cc WHERE {
  ?c wdt:P1082 ?pop ; wdt:P625 ?coord ; wdt:P17 ?country ; wdt:P31 ?t .
  ?country wdt:P297 ?cc .
  VALUES ?t { wd:Q515 wd:Q1549591 wd:Q3957 wd:Q208511 wd:Q1637706 wd:Q5119 wd:Q200250 wd:Q1093829 wd:Q486972 }
  FILTER(?pop >= 300000)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "zh-hans,zh,en". }
}
